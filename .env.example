BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000
# Use these MongoDB settings when connecting to an Atlas replica set.
DB_USER=replace_me
DB_PASSWORD=replace_me
# Optional fallback when using a complete MongoDB connection string instead.
BETTER_AUTH_DB_URI=mongodb+srv://<username>:<password>@<cluster>/wed-plan?retryWrites=true&w=majority
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
